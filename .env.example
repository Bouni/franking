# Dry run: no Sendcloud label is bought and no invoice email
# is sent. docker-compose-dev.yaml sets DEBUG from DEV_DEBUG (default true)
DEBUG=false
# DEV_DEBUG=true
# Where labels (and settings.json) are stored
LABEL_PATH="/opt/docker/invio/labels"
# Invio
INVIO_URL="https://invio.example.com/api/v1"
INVIO_USER="admin"
INVIO_PASSWORD="password"
# INVIO_DB_PATH="/app/invio.db"
# Email (SMTP over SSL) for invoices and tracking links
EMAIL_SMTP_SERVER="smtp.example.com"
EMAIL_SMTP_PORT=465
EMAIL_USER="mail@example.com"
EMAIL_PASSWORD="password"
EMAIL_SENDER="mail@example.com"
# PayPal API (payment check)
PAYPAL_CLIENT_ID="client-id"
PAYPAL_SECRET="secret"
# Sparkasse FinTS (payment check)
SPK_BLZ="12345678"
SPK_USER="username"
SPK_PIN="pin"
SPK_IBAN="DE00123456780000000000"
SPK_BIC="BICXXXXXXXX"
SPK_ACCOUNT="0000000000"
# SPK_SUB_ACCOUNT=""
# FinTS product registration number
SPK_PRODUCT_ID="product-id"
# SPK_FINTS_PATH="fints_state.bin"
# Sender data
SENDER_NAME="Sender Name"
SENDER_ADDRESS="Street 123"
SENDER_POSTCODE="12345"
SENDER_CITY="City"
SENDER_COUNTRY="DEU"
# Sendcloud API (Settings > Integrations > Sendcloud API)
SENDCLOUD_PUBLIC_KEY="public-key"
SENDCLOUD_PRIVATE_KEY="private-key"
# Optional, otherwise the SENDER_* data is used
SENDCLOUD_SENDER_ADDRESS_ID=""
# Shipping option codes, list the available ones with ./sendcloud-test.sh --all
# Germany: DHL Kleinpaket, international: DHL Warenpost International Premium
SENDCLOUD_OPTION_NATIONAL="dhl_de:warenpost"
SENDCLOUD_OPTION_INTERNATIONAL="dhl_de:warenpostinternational/premium"
# VAT ID (USt-IdNr.) and optional EORI number, required for exports out of the EU
SENDER_VAT_ID="DE123456789"
SENDER_EORI=""
# Shipping prices and labels use the weight of the goods (weight per piece
# from Invio) plus the packaging, rounded up to the next price step of DHL
# Warenpost
SENDCLOUD_PACKAGING_G=19
SENDCLOUD_WEIGHT_STEP_G=100
# Settings from the Settings tab (e.g. the tracking email text), defaults to
# settings.json in LABEL_PATH
SETTINGS_PATH=""
# ntfy notifications (new orders, received payments)
NTFY_URL="https://ntfy.example.com/franking"
NTFY_TOKEN=""
# Seconds between automatic PayPal / Sparkasse checks, 0 = off.
# Defaults to 600, and to off when DEBUG is true
# PAYMENT_CHECK_INTERVAL=600
# Printers
MFC_IP="192.168.88.21"
QL1110_IP="192.168.88.14"
# Margin around die-cut labels in dots (300 dpi, 36 dots ~ 3mm)
# DIE_CUT_MARGIN=36
